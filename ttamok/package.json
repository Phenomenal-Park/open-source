{
  "name": "ttamok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "따목 (Ttamok) — 오목 + 두 점 따내기 웹게임",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate:ratings": "node scripts/simulate-ratings.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
