{
  "name": "ddamok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "따목 (Ddamok) — 오목 + 두 점 따내기 웹게임",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler d1 migrations apply ddamok --local && wrangler dev --port 8787 --var DEV_MAIL_LOG:1",
    "start": "vite build && npm run dev:api",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:worker": "vite build && node tests/worker.mjs",
    "test:e2e": "vite build && node tests/e2e.mjs",
    "deploy": "vite build && wrangler d1 migrations apply ddamok --remote && wrangler deploy",
    "cf:types": "wrangler types worker/worker-configuration.d.ts",
    "simulate:ratings": "node scripts/simulate-ratings.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
