{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["./*.ts", "../src/game/*.ts", "../src/rating/*.ts", "../src/ai/*.ts", "../src/online/protocol.ts"],
  "exclude": ["../src/**/*.test.ts", "../src/game/testUtils.ts", "../src/ai/worker.ts", "./*.test.ts"]
}
