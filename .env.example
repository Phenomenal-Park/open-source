# ── Public (safe to expose to the browser) ─────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key only. NEVER put the service-role/secret key anywhere in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional vector map style id
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Ads stay off until monetization phase (§140)
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
# Shows labelled empty ad-slot placeholders for layout review (never in production)
NEXT_PUBLIC_ADS_PREVIEW=false
# Public storage base for photo paths (e.g. Supabase Storage public bucket or Cloudflare R2)
NEXT_PUBLIC_PHOTO_BASE_URL=

# ── Server only ────────────────────────────────────────────────────────
# Random secret shared with the database (app_settings.server_secret_hash = sha256 hex of this).
# Public RPCs refuse calls without it. Generate: openssl rand -hex 32
MSM_SERVER_SECRET=
# Optional review translation provider (none → originals are shown)
TRANSLATION_PROVIDER=

# ── Local development only (refused when NODE_ENV=production) ────────────
# Use a local Postgres (scripts/local-db.sh) instead of Supabase.
MSM_LOCAL_DB_URL=
MSM_LOCAL_ADMIN_EMAIL=
MSM_LOCAL_ADMIN_PASSWORD=
MSM_LOCAL_SESSION_SECRET=
