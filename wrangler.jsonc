{
  // Cloudflare Workers deployment via OpenNext (docs/DEPLOY.ko.md)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myeongdong-street-map",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true }
  // Runtime secret (set in the dashboard or `npx wrangler secret put MSM_SERVER_SECRET`): MSM_SERVER_SECRET
  // NEXT_PUBLIC_* values are inlined at BUILD time: set them as build variables.
}
